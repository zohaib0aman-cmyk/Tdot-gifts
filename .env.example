# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 32+ random characters — signs admin & customer session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Admin panel (/admin) ────────────────────────────────────────────────
ADMIN_EMAIL=admin@giftsandsurprises.us
ADMIN_PASSWORD=change-me

# ─── Supabase (database, auth, storage) — optional: demo store is used if empty
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe (TEST mode keys: pk_test_… / sk_test_…) — optional
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── PayPal sandbox — optional
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ─── Email (Resend) — optional: emails are logged in Admin → Inbox if empty
RESEND_API_KEY=
EMAIL_FROM="Gifts & Surprises USA <orders@yourdomain.com>"
